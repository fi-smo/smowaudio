// The exe's icon, version details and manifest; build.rs compiles this into the app.
#include <winver.h>

1 ICON "../icons/icon.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     VERSION_COMMAS
PRODUCTVERSION  VERSION_COMMAS
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "fi-smo"
      VALUE "FileDescription", "Smowaudio"
      VALUE "FileVersion", VERSION_TEXT
      VALUE "InternalName", "smowaudio"
      VALUE "OriginalFilename", "smowaudio.exe"
      VALUE "ProductName", "Smowaudio"
      VALUE "ProductVersion", VERSION_TEXT
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
