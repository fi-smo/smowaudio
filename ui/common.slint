// Shared by the tray flyout and the main window: the theme (the same colours as the old
// ui/style.css), whole-pixel helpers, and small building blocks.

// ---------- theme ----------
export global Theme {
    in property <bool> dark: true;

    out property <color> window: dark ? #16181d : #f6f7f9;
    out property <color> panel: dark ? #1d2027 : #ffffff;
    out property <color> raised: dark ? #262a33 : #eef0f4;
    out property <color> well: dark ? #111318 : #dfe3e9;
    out property <color> line: dark ? #2b303a : #d5d9e0;
    out property <color> line-strong: dark ? #3d4452 : #b7bdc8;
    out property <color> text: dark ? #e9e6df : #1a1d23;
    out property <color> muted: dark ? #a1a7b2 : #586070;
    out property <color> faint: dark ? #6d7481 : #868d99;
    out property <color> game: dark ? #f0a23b : #b86e0c;
    out property <color> chat: dark ? #4cc4a0 : #13896d;
    out property <color> media: dark ? #ea6a92 : #bd3a66;
    out property <color> aux: dark ? #949bff : #5059cf;
    out property <color> mic: dark ? #6cc0f2 : #1b7fb8;
    out property <color> master: dark ? #d9d5cc : #3a404c;
    out property <color> tape-ink: #14161a;
    // Master's tape is dark in the light theme, so its label needs light ink there.
    out property <color> master-ink: dark ? tape-ink : window;
    out property <color> ok: dark ? #58c47e : #2d9a5a;
    out property <color> warn: dark ? #e6c14a : #c29310;
    out property <color> hot: dark ? #ec5b56 : #cf423c;
    out property <color> seg-off: dark ? #262a32 : #d3d8df;
    out property <color> focus: dark ? #6cc0f2 : #1b7fb8;

    out property <string> font-ui: "Segoe UI Variable Text";
    out property <string> font-label: "Bahnschrift";
    out property <string> font-num: "Cascadia Mono";

    // Row colours by index: Game, Chat, Media, Aux, Master.
    public pure function row-color(i: int) -> color {
        i == 0 ? game : i == 1 ? chat : i == 2 ? media : i == 3 ? aux : master
    }
}

// ---------- pixels ----------
// At 150 % scaling one logical pixel is 1.5 screen pixels, and an edge that lands on half a pixel
// gets smoothed into a blur. The browser rounded such edges to whole pixels; here small shapes
// (meter dots, fader parts, icons) do it themselves: `align` turns an offset inside a parent at
// `origin` (its absolute position in the window) into one whose edge falls on a whole pixel.
export global Px {
    /// Screen pixels per logical pixel (1.5 at 150 %), set from Rust: globals can't read it.
    in property <float> scale: 1;
    public pure function align(offset: length, origin: length) -> length {
        round((origin + offset) / 1px * scale) / scale * 1px - origin
    }
    /// A hairline: one logical pixel, rounded down to whole screen pixels (at least one).
    public pure function hair() -> length {
        max(1, floor(scale)) / scale * 1px
    }
}

// ---------- building blocks ----------
export component Icon inherits Path {
    in property <float> size: 16;
    viewbox-width: size;
    viewbox-height: size;
    fill: transparent;
    stroke-width: 1.4px;
    stroke-line-cap: round;
    stroke-line-join: round;
}

/// A channel label like the mixer's "tapes".
export component Tape inherits Rectangle {
    in property <string> label;
    in property <color> tint;
    in property <color> ink: Theme.tape-ink;
    // 13px with 6px padding in the flyout, 15px with 8px in the mixer.
    in property <length> font-size: 13px;
    in property <length> pad: 6px;
    background: tint;
    border-radius: 3px;
    height: 19px;
    width: t.preferred-width + 2 * pad;
    t := Text {
        text: label.to-uppercase();
        color: ink;
        font-family: Theme.font-label;
        font-size: root.font-size;
        font-weight: 600;
        letter-spacing: 0.06 * root.font-size;
        vertical-alignment: center;
        horizontal-alignment: center;
        y: 1px;
        height: parent.height;
    }
}

/// A small bordered button; `pressed-style` gives the "on" look (red for mute, blue for listen).
export component Btn inherits Rectangle {
    in property <bool> on;
    in property <color> on-color: Theme.hot;
    in property <length> radius: 6px;
    in property <string> label;
    callback clicked;
    accessible-role: button;
    accessible-label: label;
    accessible-checked: on;
    accessible-action-default => { root.clicked(); }
    out property <bool> hovered: ta.has-hover;
    out property <color> ink: on ? on-color : Theme.text;
    border-radius: radius;
    border-width: Px.hair();
    border-color: on ? on-color : ta.has-hover ? Theme.line-strong : Theme.line;
    background: on ? on-color.mix(Theme.panel, 0.16) : Theme.raised;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    @children
}

/// 30 LED-style segments, like the mixer's meters, with a peak-hold mark. Every segment starts and
/// ends on a whole screen pixel, so the dots stay sharp at any display scaling.
export component HMeter inherits Rectangle {
    in property <float> level; // 0..1
    in property <float> peak; // 0..1
    in property <bool> single-color;
    property <int> count: 30;
    property <int> lit: round(level * count);
    property <int> peak-at: round(peak * count) - 1;
    property <length> ax: self.absolute-position.x;
    property <length> ay: self.absolute-position.y;
    // In screen pixels: every segment gets the same whole width; the gaps take up the rest
    // (2 or 3 pixels at 150 %), which the eye notices far less than uneven dots.
    property <float> sc: Px.scale;
    property <float> ax-p: ax / 1px * sc;
    property <float> gap-p: max(1, round(2 * sc));
    property <float> pitch-p: (self.width / 1px * sc + gap-p) / count;
    property <float> seg-p: max(1, round(pitch-p - gap-p));
    // Top and bottom of a segment, and of the taller peak mark.
    property <length> top: Px.align(1px, ay);
    property <length> bottom: Px.align(5px, ay);
    property <length> peak-top: Px.align(0, ay);
    property <length> peak-bottom: Px.align(6px, ay);
    height: 6px;
    for i in count: Rectangle {
        x: (round(ax-p + i * pitch-p) - ax-p) / sc * 1px;
        width: seg-p / sc * 1px;
        // The peak mark is a little taller than the segments around it.
        y: i == peak-at ? peak-top : top;
        height: i == peak-at ? peak-bottom - peak-top : bottom - top;
        border-radius: 1px;
        background: i == peak-at ? Theme.text.with-alpha(0.7)
            : i >= lit ? Theme.seg-off
            : single-color ? Theme.ok
            : i >= count * 0.85 ? Theme.hot
            : i >= count * 0.7 ? Theme.warn
            : Theme.ok;
    }
}

/// Horizontal fader: same groove, colour fill, unity mark and cap as the mixer's. Drag, click,
/// scroll or use the arrow keys; double-click resets to 100 %.
export component HFader inherits Rectangle {
    in property <float> value; // 0..1.5, from the app
    in property <color> tint;
    callback changed(float);
    property <float> top: 1.5;
    property <length> ax: self.absolute-position.x;
    property <length> ay: self.absolute-position.y;
    // Edges of the groove and fill (4px tall, centred), and of the cap (18px tall).
    property <length> groove-top: Px.align(7px, ay);
    property <length> groove-bottom: Px.align(11px, ay);
    property <length> inset: 6px;
    property <length> track: self.width - 2 * inset;
    property <float> dragged: value;
    out property <bool> dragging: ta.pressed;
    out property <float> shown: dragging ? dragged : value;
    in property <string> label;
    height: 18px;
    accessible-role: slider;
    accessible-label: label + " volume";
    accessible-value: round(shown * 100);
    accessible-value-minimum: 0;
    accessible-value-maximum: 150;
    accessible-value-step: 2;
    accessible-action-increment => { set(value + 0.02); }
    accessible-action-decrement => { set(value - 0.02); }
    accessible-action-set-value(v) => { set(v.to-float() / 100); }

    // A wheel or key step: no snapping, or a step down from 100 % (to 98 %) would snap straight
    // back and the fader would never leave it.
    function set(v: float) {
        root.dragged = max(0, min(root.top, v));
        root.changed(root.dragged);
    }
    // Dragging snaps to unity, like the mixer, so it's easy to land on 100 %.
    function from-x(x: length) {
        let v = max(0, min(1, (x - inset - 3px) / (track - 6px))) * root.top;
        set(abs(v - 1) < 0.03 ? 1 : v);
    }

    // Groove.
    Rectangle {
        x: Px.align(inset, ax);
        width: Px.align(inset + track, ax) - Px.align(inset, ax);
        y: groove-top;
        height: groove-bottom - groove-top;
        background: Theme.well;
        border-width: Px.hair();
        border-color: Theme.line;
        border-radius: 2px;
    }
    // Unity (100 %) mark.
    Rectangle {
        x: Px.align(inset + track * (1 / root.top), ax);
        width: Px.hair();
        y: Px.align(2px, ay);
        height: Px.align(16px, ay) - Px.align(2px, ay);
        background: Theme.line-strong;
    }
    // Fill.
    Rectangle {
        x: Px.align(inset, ax);
        width: Px.align(inset + track * (shown / root.top), ax) - Px.align(inset, ax);
        y: groove-top;
        height: groove-bottom - groove-top;
        background: tint.with-alpha(0.9);
        border-radius: 2px;
    }
    // Cap.
    cap := Rectangle {
        x: Px.align(inset + track * (shown / root.top) - 6px, ax);
        width: Px.align(inset + track * (shown / root.top) + 6px, ax) - self.x;
        y: Px.align(0, ay);
        height: Px.align(18px, ay) - self.y;
        border-radius: 4px;
        border-width: Px.hair();
        border-color: Theme.line-strong;
        background: @linear-gradient(90deg, Theme.raised 0%, Theme.panel 100%);
        drop-shadow-blur: 4px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #0000002e;
        Rectangle {
            x: Px.align((cap.width - 2px) / 2, root.ax + cap.x);
            width: Px.align((cap.width + 2px) / 2, root.ax + cap.x) - self.x;
            y: Px.align(4px, root.ay + cap.y);
            height: Px.align(cap.height - 4px, root.ay + cap.y) - self.y;
            background: tint;
            border-radius: 1px;
        }
    }
    ta := TouchArea {
        mouse-cursor: ew-resize;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                focus.focus();
                root.from-x(self.mouse-x);
            }
        }
        moved => {
            if self.pressed { root.from-x(self.mouse-x); }
        }
        double-clicked => { root.set(1); }
        scroll-event(e) => {
            root.set(root.value + (e.delta-y > 0 ? 0.02 : -0.02));
            accept
        }
    }
    focus := FocusScope {
        key-pressed(e) => {
            if e.text == Key.RightArrow || e.text == Key.UpArrow { root.set(root.value + 0.02); return accept; }
            if e.text == Key.LeftArrow || e.text == Key.DownArrow { root.set(root.value - 0.02); return accept; }
            if e.text == Key.PageUp { root.set(root.value + 0.1); return accept; }
            if e.text == Key.PageDown { root.set(root.value - 0.1); return accept; }
            if e.text == Key.Home { root.set(1); return accept; }
            reject
        }
    }
}

/// A Windows 11 icon from Segoe Fluent Icons. The font is hinted for small sizes, so unlike a
/// drawn path it stays sharp at 125 % and 150 % scaling. `tint` sets its colour.
export component Glyph inherits Text {
    in property <string> glyph;
    in property <brush> tint: Theme.text;
    text: glyph;
    font-family: "Segoe Fluent Icons";
    font-size: 16px;
    color: tint;
    horizontal-alignment: center;
    vertical-alignment: center;
}

/// The glyphs in use, by what they show.
export global Glyphs {
    out property <string> speaker: "\u{E767}";
    out property <string> speaker-off: "\u{E74F}";
    out property <string> headphones: "\u{E7F6}";
    out property <string> mic: "\u{E720}";
    out property <string> play: "\u{E768}";
    out property <string> move: "\u{E8AB}";
    out property <string> chevron-down: "\u{E96E}";
    out property <string> chevron-up: "\u{E96D}";
    out property <string> chevron-right: "\u{E970}";
    out property <string> apps: "\u{E8A9}";
    out property <string> settings: "\u{E713}";
}

export component SpeakerIcon inherits Glyph {
    in property <bool> off;
    glyph: off ? Glyphs.speaker-off : Glyphs.speaker;
}

export component HeadphonesIcon inherits Glyph {
    glyph: Glyphs.headphones;
    font-size: 14px;
}

export component MicIcon inherits Glyph {
    glyph: Glyphs.mic;
    font-size: 14px;
}

/// An on/off switch (36×20 track, 12px knob), optionally with a label after it.
export component Switch inherits HorizontalLayout {
    in-out property <bool> checked;
    in property <string> text;
    in property <string> label; // for screen readers when there's no text
    in property <color> tint: Theme.mic;
    callback toggled(bool);
    spacing: 8px;
    alignment: start;
    track := Rectangle {
        width: 36px;
        height: 20px;
        y: (parent.height - 20px) / 2;
        border-radius: 10px;
        background: root.checked ? root.tint : Theme.well;
        border-width: Px.hair();
        border-color: root.checked ? root.tint : Theme.line-strong;
        Rectangle {
            x: root.checked ? 19px : 3px;
            y: (parent.height - 12px) / 2;
            width: 12px;
            height: 12px;
            border-radius: 6px;
            background: root.checked ? Theme.panel : Theme.muted;
            animate x { duration: 150ms; }
        }
        animate background { duration: 150ms; }
    }
    if root.text != "": Text {
        text: root.text;
        color: Theme.muted;
        font-size: 12px;
        vertical-alignment: center;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
    accessible-role: switch;
    accessible-label: root.text != "" ? root.text : root.label;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.checked = !root.checked;
        root.toggled(root.checked);
    }
}

/// A row of options with one selected, like the old `.seg` buttons (EQ presets, tabs).
export component Seg inherits Rectangle {
    in property <[string]> options;
    in property <string> current;
    // Options that can't be picked (shown faded), e.g. "Custom" until the curve is edited.
    in property <[string]> disabled;
    in property <length> font-size: 13px;
    callback picked(string);
    height: row.preferred-height + 8px;
    width: row.preferred-width + 8px;
    background: Theme.well;
    border-width: Px.hair();
    border-color: Theme.line;
    border-radius: 8px;
    row := HorizontalLayout {
        x: 4px;
        y: 4px;
        spacing: 2px;
        for o in root.options: Rectangle {
            property <bool> on: o == root.current;
            property <bool> off: o != root.current && root.disabled.length > 0 && root.disabled[0] == o;
            width: label.preferred-width + 20px;
            height: label.preferred-height + 8px;
            border-radius: 6px;
            background: on ? Theme.panel : transparent;
            drop-shadow-blur: on ? 2px : 0;
            drop-shadow-offset-y: on ? 1px : 0;
            drop-shadow-color: #0000001f;
            label := Text {
                text: o;
                color: on ? Theme.text : Theme.muted;
                opacity: off ? 0.55 : 1;
                font-size: root.font-size;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                enabled: !off;
                mouse-cursor: off ? default : pointer;
                clicked => { root.picked(o); }
            }
            accessible-role: button;
            accessible-label: o;
            accessible-checked: on;
            accessible-action-default => { if !off { root.picked(o); } }
        }
    }
}

/// A panel with a title and help text in its header, and an optional switch on the right.
export component Card inherits Rectangle {
    in property <string> title;
    in property <string> help;
    in property <bool> has-switch;
    in-out property <bool> switch-on;
    in property <color> tint: Theme.mic;
    in property <string> switch-label;
    callback switched(bool);
    background: Theme.panel;
    border-width: Px.hair();
    border-color: Theme.line;
    border-radius: 8px;
    height: body.preferred-height;
    body := VerticalLayout {
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 12px;
            padding-bottom: 10px;
            spacing: 16px;
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Text { text: root.title; color: Theme.text; font-size: 15px; font-weight: 600; }
                if root.help != "": Text {
                    text: root.help;
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
            if root.has-switch: VerticalLayout {
                alignment: start;
                horizontal-stretch: 0;
                padding-top: 2px;
                Switch {
                    checked <=> root.switch-on;
                    text: root.switch-on ? "On" : "Off";
                    label: root.switch-label;
                    tint: root.tint;
                    toggled(on) => { root.switched(on); }
                }
            }
        }
        @children
    }
}

/// A horizontal range slider like the browser's: a 4px track filled in the tint up to a round
/// thumb. Drag, click, scroll or use the arrow keys.
export component Slider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <float> value;
    in property <color> tint: Theme.mic;
    in property <string> label;
    callback changed(float);
    property <float> frac: max(0, min(1, (value - minimum) / (maximum - minimum)));
    height: 20px;
    accessible-role: slider;
    accessible-label: label;
    accessible-value: value;
    accessible-value-minimum: minimum;
    accessible-value-maximum: maximum;
    accessible-value-step: step;
    accessible-action-increment => { set(value + step); }
    accessible-action-decrement => { set(value - step); }
    accessible-action-set-value(v) => { set(v.to-float()); }

    function set(v: float) {
        let snapped = round((max(minimum, min(maximum, v)) - minimum) / step) * step + minimum;
        if snapped != value { root.changed(snapped); }
    }
    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.well;
        border-width: Px.hair();
        border-color: Theme.line;
    }
    Rectangle {
        x: 0;
        y: (parent.height - 4px) / 2;
        width: (parent.width - 16px) * root.frac + 8px;
        height: 4px;
        border-radius: 2px;
        background: root.tint;
    }
    Rectangle {
        x: (parent.width - 16px) * root.frac;
        y: (parent.height - 16px) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.tint;
        border-width: 2px;
        border-color: Theme.panel;
    }
    focus := FocusScope {
        key-pressed(e) => {
            if e.text == Key.RightArrow || e.text == Key.UpArrow { root.set(root.value + root.step); return accept; }
            if e.text == Key.LeftArrow || e.text == Key.DownArrow { root.set(root.value - root.step); return accept; }
            reject
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                focus.focus();
                root.set(root.minimum + max(0, min(1, (self.mouse-x - 8px) / (root.width - 16px))) * (root.maximum - root.minimum));
            }
        }
        moved => {
            if self.pressed {
                root.set(root.minimum + max(0, min(1, (self.mouse-x - 8px) / (root.width - 16px))) * (root.maximum - root.minimum));
            }
        }
        scroll-event(e) => {
            root.set(root.value + (e.delta-y > 0 ? root.step : -root.step));
            accept
        }
    }
}

/// A labelled slider row: name and value above, slider below (the old `.ctl`).
export component SliderRow inherits VerticalLayout {
    in property <string> label;
    in property <string> shown;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <float> value;
    in property <color> tint: Theme.mic;
    callback changed(float);
    spacing: 2px;
    HorizontalLayout {
        Text { text: root.label; color: Theme.muted; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
        Text { text: root.shown; color: Theme.text; font-family: Theme.font-num; font-size: 13px; vertical-alignment: center; }
    }
    Slider {
        minimum: root.minimum;
        maximum: root.maximum;
        step: root.step;
        value: root.value;
        tint: root.tint;
        label: root.label;
        changed(v) => { root.changed(v); }
    }
}

/// A compact number field: drag up or down to change it (a step per 3px), or click and type.
export component ValueField inherits Rectangle {
    in property <string> label;
    in property <string> unit;
    in property <float> value;
    in property <float> minimum;
    in property <float> maximum;
    in property <float> step: 1;
    callback changed(float);
    property <float> start-value;
    property <bool> dragged;
    height: 44px;
    border-radius: 6px;
    border-width: Px.hair();
    border-color: input.has-focus ? Theme.mic : Theme.line;
    background: Theme.raised;
    accessible-role: spinbox;
    accessible-label: root.label + " in " + root.unit;
    accessible-value: root.value;
    accessible-action-increment => { set(value + step); }
    accessible-action-decrement => { set(value - step); }
    accessible-action-set-value(v) => { set(v.to-float()); }

    function set(v: float) {
        root.changed(round(max(minimum, min(maximum, v)) / step) * step);
    }
    function shown(v: float) -> string {
        step < 1 ? round(v * 10) / 10 : round(v)
    }
    VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 2px;
        Text { text: root.label; color: Theme.faint; font-size: 11px; }
        HorizontalLayout {
            spacing: 4px;
            input := TextInput {
                text: root.shown(root.value);
                color: Theme.text;
                font-family: Theme.font-num;
                font-size: 13px;
                font-weight: 500;
                horizontal-stretch: 0;
                min-width: 20px;
                accepted => {
                    if self.text.is-float() { root.set(self.text.to-float()); }
                    self.text = root.shown(root.value);
                    self.clear-focus();
                }
                key-pressed(e) => {
                    if e.text == Key.UpArrow { root.set(root.value + root.step); return accept; }
                    if e.text == Key.DownArrow { root.set(root.value - root.step); return accept; }
                    reject
                }
            }
            Text { text: root.unit; color: Theme.faint; font-family: Theme.font-num; font-size: 11px; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    // Dragging changes the value; a click without moving types into it.
    TouchArea {
        mouse-cursor: ns-resize;
        property <length> start-y;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                self.start-y = self.mouse-y;
                root.start-value = root.value;
                root.dragged = false;
            }
            if e.kind == PointerEventKind.up && !root.dragged { input.focus(); }
        }
        moved => {
            if !self.pressed { return; }
            let d = round((self.start-y - self.mouse-y) / 3px);
            if !root.dragged && abs(d) < 1 { return; }
            root.dragged = true;
            root.set(root.start-value + d * root.step);
        }
    }
}

/// A plain text button in the old `.btn` look, with an optional 14px icon before the text.
export component TextButton inherits Btn {
    in property <string> text;
    in property <string> icon; // a Glyphs character, or ""
    in property <length> font-size: 12px;
    in property <bool> enabled: true;
    label: text;
    opacity: enabled ? 1 : 0.45;
    min-width: row.preferred-width + 4px;
    preferred-width: row.preferred-width + 4px;
    horizontal-stretch: 0;
    row := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        padding-left: 10px;
        padding-right: 10px;
        if root.icon != "": Glyph {
            width: 14px;
            glyph: root.icon;
            font-size: 14px;
            tint: root.ink;
        }
        Text { text: root.text; color: root.ink; font-size: root.font-size; vertical-alignment: center; }
    }
}

/// A link-looking button ("Change", "Reset to defaults").
export component LinkButton inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.focus;
    callback clicked;
    width: t.preferred-width + 4px;
    height: t.preferred-height + 4px;
    border-radius: 4px;
    t := Text {
        text: root.text;
        color: ta.has-hover ? Theme.text : root.tint;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
}
