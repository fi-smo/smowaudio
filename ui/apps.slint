// The Apps view: a column per channel holding the apps that play there. Drag a card to another
// column (or use its Move menu) to route the app there; Windows remembers it.

import { Theme, Px, Icon, Tape } from "common.slint";
import { AppIcon, AppBadge } from "mixer.slint";

export struct AppCardData {
    exe: string,
    icon: AppIcon,
    channel: int, // 0..3
    chosen: bool, // placed on purpose (else it follows the Windows default, Game)
    level: string, // "−12.3 dB" or "−∞"
    silent: bool,
    lit: int, // meter segments lit, 0..12
    peak: int, // segment with the peak mark, or -1
    stuck: bool, // still playing elsewhere after a move: "Reopen to move"
    stuck-title: string,
}

export struct LaneData {
    name: string,
    cards: [AppCardData],
}

/// Twelve segments up the card's right edge, in the meters' colours, with a peak mark.
component CardMeter inherits Rectangle {
    in property <int> lit;
    in property <int> peak;
    property <int> count: 12;
    property <float> sc: Px.scale;
    property <float> ay-p: self.absolute-position.y / 1px * sc;
    property <float> h-p: self.height / 1px * sc;
    property <float> gap-p: max(1, round(2 * sc));
    property <float> pitch-p: (h-p + gap-p) / count;
    property <float> seg-p: max(1, round(pitch-p - gap-p));
    width: 8px;
    for i in count: Rectangle {
        // Segment i from the bottom; every one the same whole-pixel height.
        property <float> top-p: round(ay-p + h-p - (i + 1) * pitch-p + gap-p);
        y: (top-p - ay-p) / sc * 1px;
        height: seg-p / sc * 1px;
        border-radius: 1px;
        background: i < root.lit
            ? (i >= root.count * 0.85 ? Theme.hot : i >= root.count * 0.7 ? Theme.warn : Theme.ok)
            : i == root.peak ? Theme.muted : Theme.well;
    }
}

/// One app: icon, name and exe, "Default" badge or "Reopen to move", level, Move button, meter.
export component AppCard inherits Rectangle {
    in property <AppCardData> app;
    in property <bool> ghost; // the tilted preview inside a drop zone
    in property <bool> placeholder; // the card being dragged, left behind faded
    in property <[string]> channel-names;
    callback move-to(int); // -1 = follow the Windows default
    // Dragging: where the pointer is, in the card's own coordinates, as it moves and is released.
    callback drag-moved(length, length);
    callback drag-ended(length, length);
    property <bool> dragging;
    height: 50px;
    border-radius: 6px;
    border-width: Px.hair();
    border-color: ghost ? Theme.line-strong : Theme.line;
    background: placeholder ? transparent : Theme.raised;
    opacity: placeholder ? 0.4 : 1;
    drop-shadow-blur: ghost ? 24px : 0;
    drop-shadow-offset-y: ghost ? 12px : 0;
    drop-shadow-color: #00000040;
    transform-rotation: ghost ? -2deg : 0deg;
    clip: false;

    ta := TouchArea {
        property <length> start-x;
        property <length> start-y;
        mouse-cursor: root.ghost ? default : root.dragging ? MouseCursor.grabbing : MouseCursor.grab;
        enabled: !root.ghost;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                self.start-x = self.mouse-x;
                self.start-y = self.mouse-y;
            }
            if e.kind == PointerEventKind.up && root.dragging {
                root.dragging = false;
                root.drag-ended(self.mouse-x, self.mouse-y);
            }
        }
        moved => {
            if !self.pressed { return; }
            if !root.dragging && abs(self.mouse-x - self.start-x) + abs(self.mouse-y - self.start-y) > 5px {
                root.dragging = true;
            }
            if root.dragging { root.drag-moved(self.mouse-x, self.mouse-y); }
        }
    }

    HorizontalLayout {
        padding: 8px;
        spacing: 10px;
        // Icon (30px), or a tile with the first letter.
        Rectangle {
            width: 32px;
            border-radius: 7px;
            background: root.app.icon.has-image ? transparent : Theme.panel;
            border-width: root.app.icon.has-image ? 0 : Px.hair();
            border-color: Theme.line;
            if root.app.icon.has-image: Image {
                x: 1px;
                y: (parent.height - 30px) / 2;
                width: 30px;
                height: 30px;
                source: root.app.icon.image;
                image-fit: contain;
            }
            if !root.app.icon.has-image: Text {
                text: root.app.icon.letter;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            min-width: 0;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.app.icon.name;
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 500;
                    overflow: elide;
                    horizontal-stretch: 0;
                    max-width: self.preferred-width;
                }
                Text {
                    text: root.app.exe;
                    color: Theme.faint;
                    font-family: Theme.font-num;
                    font-size: 11px;
                    overflow: elide;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                height: 16px;
                if !root.app.chosen: Rectangle {
                    width: badge.preferred-width + 10px;
                    border-radius: 4px;
                    border-width: Px.hair();
                    border-color: Theme.line;
                    badge := Text {
                        text: "DEFAULT";
                        color: Theme.muted;
                        font-size: 10px;
                        font-weight: 600;
                        letter-spacing: 0.06 * 10px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    accessible-role: text;
                    accessible-label: "Not placed yet: follows the Windows default, Game";
                }
                if root.app.stuck && !root.ghost: Text {
                    text: "Reopen to move";
                    color: Theme.warn;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-label: root.app.stuck-title;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.app.silent ? "−∞" : root.app.level;
                    color: root.app.silent ? Theme.faint : Theme.muted;
                    font-family: Theme.font-num;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }
        if !root.ghost: Rectangle {
            width: 28px;
            VerticalLayout {
                alignment: center;
                move := Rectangle {
                    height: 28px;
                    border-radius: 6px;
                    background: move-ta.has-hover ? Theme.panel : transparent;
                    Icon {
                        x: Px.align((parent.width - 15px) / 2, parent.absolute-position.x);
                        y: Px.align((parent.height - 15px) / 2, parent.absolute-position.y);
                        width: 15px;
                        height: 15px;
                        stroke: move-ta.has-hover ? Theme.text : Theme.muted;
                        commands: "M3 5h9M9.5 2.5 12 5 9.5 7.5M13 11H4M6.5 8.5 4 11l2.5 2.5";
                    }
                    move-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { menu.show(); }
                    }
                    accessible-role: button;
                    accessible-label: "Move " + root.app.icon.name;
                    accessible-action-default => { menu.show(); }
                }
            }
        }
        if !root.ghost: CardMeter {
            lit: root.app.lit;
            peak: root.app.peak;
        }
    }

    // Move menu: the other channels, and "Follow Windows default" for apps that were placed.
    menu := PopupWindow {
        x: root.width - 188px;
        y: root.height + 4px;
        width: 180px;
        Rectangle {
            background: Theme.panel;
            border-width: Px.hair();
            border-color: Theme.line-strong;
            border-radius: 8px;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: #0000004d;
            VerticalLayout {
                padding: 4px;
                spacing: 1px;
                Text {
                    text: "Move to";
                    color: Theme.faint;
                    font-size: 11px;
                    height: 22px;
                    vertical-alignment: center;
                    x: 8px;
                }
                for name[i] in root.channel-names: Rectangle {
                    height: i == root.app.channel ? 0 : 30px;
                    visible: i != root.app.channel;
                    border-radius: 5px;
                    background: item-ta.has-hover ? Theme.raised : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        spacing: 8px;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            y: (parent.height - 8px) / 2;
                            border-radius: 2px;
                            background: Theme.row-color(i);
                        }
                        Text { text: name; color: Theme.text; font-size: 13px; vertical-alignment: center; }
                    }
                    item-ta := TouchArea {
                        clicked => { root.move-to(i); }
                    }
                    accessible-role: button;
                    accessible-label: "Move to " + name;
                    accessible-action-default => { root.move-to(i); }
                }
                if root.app.chosen: Rectangle {
                    height: 7px;
                    Rectangle { x: 4px; width: parent.width - 8px; height: Px.hair(); background: Theme.line; }
                }
                if root.app.chosen: Rectangle {
                    height: 30px;
                    border-radius: 5px;
                    background: default-ta.has-hover ? Theme.raised : transparent;
                    Text { x: 8px; text: "Follow Windows default"; color: Theme.text; font-size: 13px; vertical-alignment: center; }
                    default-ta := TouchArea {
                        clicked => { root.move-to(-1); }
                    }
                    accessible-role: button;
                    accessible-label: "Follow Windows default";
                    accessible-action-default => { root.move-to(-1); }
                }
            }
        }
    }
}

export component AppsView inherits VerticalLayout {
    in property <[LaneData]> lanes;
    in property <int> playing;
    in property <bool> empty;
    callback move-app(string, int); // exe, channel (-1 = Windows default)
    // While dragging: the card's exe, its channel, and the lane under the pointer (-1 = none).
    property <string> drag-exe;
    property <int> drag-from: -1;
    property <int> drag-over: -1;
    property <AppCardData> drag-app;
    spacing: 16px;

    // Title, explanation, "N playing".
    HorizontalLayout {
        VerticalLayout {
            spacing: 2px;
            Text { text: "Apps"; color: Theme.text; font-size: 20px; font-weight: 600; }
            Text { text: "Drag an app onto a channel. Windows remembers where you put it."; color: Theme.muted; font-size: 13px; }
        }
        Rectangle { }
        VerticalLayout {
            alignment: start;
            Rectangle {
                width: playing-row.preferred-width + 20px;
                height: 24px;
                border-radius: 12px;
                border-width: Px.hair();
                border-color: Theme.line;
                background: Theme.panel;
                playing-row := HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    alignment: center;
                    Rectangle { width: 7px; height: 7px; y: (parent.height - 7px) / 2; border-radius: 3.5px; background: Theme.ok; }
                    Text { text: root.playing + " playing"; color: Theme.text; font-size: 12px; font-weight: 500; vertical-alignment: center; }
                }
            }
        }
    }

    if root.empty: Text {
        text: "No apps are playing audio right now. Start something and it appears here.";
        color: Theme.muted;
        font-size: 13px;
    }

    // Four columns, each as tall as its content.
    if !root.empty: lanes-row := HorizontalLayout {
        spacing: 10px;
        alignment: stretch;
        for lane[li] in root.lanes: VerticalLayout {
            alignment: start;
            width: (lanes-row.width - 30px) / 4;
            Rectangle {
                property <bool> over: root.drag-over == li && root.drag-from != li;
                background: Theme.panel;
                border-width: Px.hair();
                border-color: over ? Theme.row-color(li) : Theme.line;
                border-radius: 8px;
                height: col.preferred-height;
                animate border-color { duration: 120ms; }
                col := VerticalLayout {
                    padding: 10px;
                    spacing: 8px;
                    HorizontalLayout {
                        Tape { label: lane.name; tint: Theme.row-color(li); height: 22px; font-size: 15px; pad: 8px; }
                        Rectangle { }
                        Text {
                            text: lane.cards.length + (lane.cards.length == 1 ? " app" : " apps");
                            color: Theme.faint;
                            font-family: Theme.font-num;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                    for card in lane.cards: AppCard {
                        app: card;
                        placeholder: root.drag-exe == card.exe;
                        channel-names: ["Game", "Chat", "Media", "Aux"];
                        move-to(ch) => { root.move-app(card.exe, ch); }
                        drag-moved(x, y) => {
                            root.drag-exe = card.exe;
                            root.drag-from = li;
                            root.drag-app = card;
                            root.drag-over = root.lane-at(self.absolute-position.x + x);
                        }
                        drag-ended(x, y) => {
                            let target = root.lane-at(self.absolute-position.x + x);
                            if target >= 0 && target != li { root.move-app(card.exe, target); }
                            root.drag-exe = "";
                            root.drag-from = -1;
                            root.drag-over = -1;
                        }
                    }
                    // Drop zone: shown when the column is empty, and while a card is dragged over it.
                    if lane.cards.length == 0 || over: Rectangle {
                        height: over ? 88px : 64px;
                        border-radius: 6px;
                        border-width: Px.hair();
                        border-color: over ? Theme.row-color(li) : Theme.line;
                        background: over ? Theme.row-color(li).with-alpha(0.08) : transparent;
                        animate height { duration: 120ms; }
                        if over: AppCard {
                            x: 8px;
                            y: 8px;
                            width: parent.width - 16px;
                            app: root.drag-app;
                            ghost: true;
                        }
                        Text {
                            y: over ? parent.height - 22px : (parent.height - self.height) / 2;
                            width: parent.width;
                            text: over ? "Drop to move to " + lane.name : "Drag an app here";
                            color: over ? Theme.row-color(li) : Theme.faint;
                            font-size: 12px;
                            horizontal-alignment: center;
                        }
                    }
                    // Two lines' worth: wrapped text doesn't report its height to the layout.
                    if li == 0: HorizontalLayout {
                        spacing: 8px;
                        padding-left: 2px;
                        height: 34px;
                        Rectangle {
                            width: 14px;
                            height: 14px;
                            y: 1px;
                            border-radius: 7px;
                            border-width: Px.hair();
                            border-color: Theme.faint;
                            Text { text: "i"; color: Theme.faint; font-size: 9px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text {
                            text: "Default channel. System sounds and new apps play here.";
                            color: Theme.faint;
                            font-size: 12px;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
    }

    /// The lane under absolute x, or -1.
    function lane-at(x: length) -> int {
        let w = (self.width - 30px) / 4;
        let local = x - self.absolute-position.x;
        if local < 0 || local > self.width { return -1; }
        floor(local / (w + 10px))
    }
}
