// The main window: a rail of sections on the left, a top bar with the output and stream status,
// and the current view below it.

import { ScrollView } from "std-widgets.slint";
import { Theme, Px, Icon, TextButton, Glyph, Glyphs } from "common.slint";
import { MixerView, StripData } from "mixer.slint";
import { EqData, EqBandData } from "eq.slint";
import { AppsView, AppCardData, LaneData } from "apps.slint";
import { MicView, MicData, ChainTab } from "mic.slint";
import { SettingsView, SelectOption, DeviceRowData, StreamItem, HealthData, DelayRowData, DelayData, ShortcutGroup, ShortcutRowData, ChangeEntry, UpdatesData } from "settings.slint";

export { StripData, EqData, EqBandData, AppCardData, LaneData, MicData, ChainTab, SelectOption, DeviceRowData, StreamItem, HealthData, DelayRowData, DelayData, ShortcutGroup, ShortcutRowData, ChangeEntry, UpdatesData }

/// One section button in the rail: an icon over its name.
component RailButton inherits Rectangle {
    in property <string> label;
    in property <string> icon; // a Glyphs character
    in property <string> path; // or a 20×20 drawing, for the one without a glyph
    in property <bool> current;
    callback clicked;
    height: 56px;
    border-radius: 8px;
    background: current || ta.has-hover ? Theme.raised : transparent;
    accessible-role: tab;
    accessible-label: label;
    accessible-item-selected: current;
    accessible-action-default => { root.clicked(); }
    VerticalLayout {
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 3px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            if root.path != "": Icon {
                size: 20;
                width: 20px;
                height: 20px;
                stroke: current || ta.has-hover ? Theme.text : Theme.muted;
                stroke-width: 1.2px;
                commands: root.path;
            }
            if root.path == "": Glyph {
                width: 20px;
                height: 20px;
                glyph: root.icon;
                font-size: 20px;
                tint: current || ta.has-hover ? Theme.text : Theme.muted;
            }
        }
        Text {
            text: root.label;
            color: current || ta.has-hover ? Theme.text : Theme.muted;
            font-size: 11px;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// A rounded pill: "Output  Automatic", or with a status dot.
component Pill inherits Rectangle {
    in property <string> k;
    in property <string> v;
    in property <bool> dot;
    in property <bool> warn;
    in property <bool> clickable;
    callback clicked;
    width: min(row.preferred-width + 20px, 320px);
    height: 24px;
    border-radius: 12px;
    border-width: Px.hair();
    border-color: Theme.line;
    background: Theme.panel;
    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;
        if root.dot: Rectangle {
            width: 7px;
            height: 7px;
            y: (parent.height - 7px) / 2;
            border-radius: 3.5px;
            background: root.warn ? Theme.warn : Theme.ok;
        }
        if root.k != "": Text {
            text: root.k;
            color: Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
        }
        Text {
            text: root.v;
            color: Theme.text;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if root.clickable: TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    accessible-role: button;
    accessible-label: root.k + " " + root.v;
    accessible-action-default => { root.clicked(); }
}

export component MainWindow inherits Window {
    // "mixer", "apps", "mic" or "settings".
    in-out property <string> view: "mixer";
    in property <string> output-name: "…";
    in property <string> status-text: "Starting";
    in property <bool> status-warn;
    in property <string> update-version; // "" = no update

    // Mixer: the four channels, Master and Mic.
    in property <[StripData]> channels;
    in property <StripData> master;
    in property <StripData> mic;
    in property <string> buffer: "–";
    in property <int> eq-open: -1;
    in property <EqData> eq;
    in-out property <int> eq-selected: -1;
    callback eq-toggled(bool);
    callback eq-preset(string);
    callback eq-pick(float, float, float, float, float) -> int;
    callback eq-drag(int, float, float, float, float);
    callback eq-widen(int, bool);

    // Apps.
    in property <[LaneData]> lanes;
    in property <int> apps-playing;
    in property <bool> apps-empty;
    callback move-app(string, int);

    // Mic.
    in property <MicData> mic-data;
    in property <[ChainTab]> chain;
    in-out property <string> mic-step: "denoise";
    in property <EqData> mic-eq;
    in-out property <int> mic-eq-selected: -1;
    callback mic-set(string, float);
    callback mic-toggle(string, bool);
    callback mic-mute;
    callback mic-listen;
    callback mic-test(string);
    callback open-devices;
    callback mic-eq-preset(string);
    callback mic-eq-pick(float, float, float, float, float) -> int;
    callback mic-eq-drag(int, float, float, float, float);
    callback mic-eq-widen(int, bool);

    // Settings.
    in-out property <string> settings-tab: "devices";
    in property <[DeviceRowData]> playback-rows;
    in property <[DeviceRowData]> cable-rows;
    in property <bool> master-per-output;
    in property <HealthData> health;
    in-out property <bool> health-expanded;
    in property <DelayData> delay;
    in property <bool> launch-at-login;
    in property <bool> windows-defaults;
    in property <[ShortcutGroup]> shortcut-groups;
    in property <[ShortcutRowData]> shortcut-rows;
    in property <string> shortcut-group: "general";
    in property <string> shortcut-group-title: "General";
    in property <float> volume-step: 0.05;
    in property <bool> any-shortcuts;
    in property <UpdatesData> updates;
    callback settings-tab-changed(string);
    callback pick-device(string, string);
    callback preference(string, bool);
    callback retry;
    callback measure;
    callback launch(bool);
    callback defaults(bool);
    callback open-log;
    callback shortcut-group-changed(string);
    callback record(string);
    callback clear-shortcut(string);
    callback use-here(string);
    callback volume-step-changed(float);
    callback reset-shortcuts;
    callback check-updates;
    callback install-update;
    callback more-changelog;

    // A short message at the bottom ("Blip now plays on Chat"); red for errors.
    in property <string> toast;
    in property <bool> toast-error;
    // A confirmation ("Clear all 3 shortcuts?") with a red action button.
    in property <string> confirm-text;
    in property <string> confirm-action;
    callback confirm-accepted;
    callback confirm-dismissed;

    callback view-changed(string);
    callback strip-volume(int, float);
    callback strip-mute(int);
    callback strip-feature(int);
    callback buffer-clicked;
    callback status-clicked;
    callback update-clicked;

    title: "Smowaudio";
    min-width: 440px;
    min-height: 520px;
    preferred-width: 1180px;
    preferred-height: 760px;
    background: Theme.window;
    default-font-family: Theme.font-ui;
    default-font-size: 14px;

    function go(v: string) {
        root.view = v;
        root.view-changed(v);
    }

    HorizontalLayout {
        // Rail.
        Rectangle {
            width: 72px;
            background: Theme.window;
            VerticalLayout {
                padding: 10px;
                padding-left: 6px;
                padding-right: 6px;
                spacing: 4px;
                RailButton {
                    label: "Mixer";
                    current: root.view == "mixer";
                    path: "M5 3v14M10 3v14M15 3v14 M3.9 11h2.2a.7 .7 0 0 1 .7 .7v1.1a.7 .7 0 0 1 -.7 .7h-2.2a.7 .7 0 0 1 -.7 -.7v-1.1a.7 .7 0 0 1 .7 -.7z M8.9 5.5h2.2a.7 .7 0 0 1 .7 .7v1.1a.7 .7 0 0 1 -.7 .7h-2.2a.7 .7 0 0 1 -.7 -.7v-1.1a.7 .7 0 0 1 .7 -.7z M13.9 8.5h2.2a.7 .7 0 0 1 .7 .7v1.1a.7 .7 0 0 1 -.7 .7h-2.2a.7 .7 0 0 1 -.7 -.7v-1.1a.7 .7 0 0 1 .7 -.7z";
                    clicked => { root.go("mixer"); }
                }
                RailButton {
                    label: "Apps";
                    current: root.view == "apps";
                    icon: Glyphs.apps;
                    clicked => { root.go("apps"); }
                }
                RailButton {
                    label: "Mic";
                    current: root.view == "mic";
                    icon: Glyphs.mic;
                    clicked => { root.go("mic"); }
                }
                Rectangle { }
                RailButton {
                    label: "Settings";
                    current: root.view == "settings";
                    icon: Glyphs.settings;
                    clicked => { root.go("settings"); }
                }
            }
        }
        Rectangle {
            width: Px.hair();
            background: Theme.line;
        }
        // Top bar and the current view.
        VerticalLayout {
            Rectangle {
                height: 45px;
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    spacing: 12px;
                    alignment: stretch;
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            width: 18px;
                            for bar[i] in [0.6, 1.0, 0.75, 0.45]: Rectangle {
                                x: i * 5px;
                                width: 3px;
                                height: 16px * bar;
                                y: (parent.height - 16px) / 2 + 16px * (1 - bar);
                                border-radius: 1px;
                                background: Theme.row-color(i);
                            }
                        }
                        Text {
                            text: "Smowaudio";
                            color: Theme.text;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        Pill { k: "Output"; v: root.output-name; }
                    }
                    if root.update-version != "": VerticalLayout {
                        alignment: center;
                        Pill {
                            k: "Update";
                            v: root.update-version;
                            clickable: true;
                            clicked => { root.update-clicked(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Pill {
                            dot: true;
                            warn: root.status-warn;
                            v: root.status-text;
                            clickable: true;
                            clicked => { root.status-clicked(); }
                        }
                    }
                }
                Rectangle {
                    x: 0;
                    width: parent.width;
                    y: parent.height - Px.hair();
                    height: Px.hair();
                    background: Theme.line;
                }
            }
            scroll := ScrollView {
                content-height: page.preferred-height;
                content-width: self.visible-width;
                page := VerticalLayout {
                    width: parent.visible-width;
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 18px;
                    padding-bottom: 24px;
                    if root.view == "mixer": MixerView {
                        // The scroll area less the page's padding.
                        available-height: scroll.visible-height - 42px;
                        channels: root.channels;
                        master: root.master;
                        mic: root.mic;
                        buffer: root.buffer;
                        volume(i, v) => { root.strip-volume(i, v); }
                        mute(i) => { root.strip-mute(i); }
                        feature(i) => { root.strip-feature(i); }
                        buffer-clicked => { root.buffer-clicked(); }
                        eq-open: root.eq-open;
                        eq: root.eq;
                        eq-selected <=> root.eq-selected;
                        eq-toggled(on) => { root.eq-toggled(on); }
                        eq-preset(p) => { root.eq-preset(p); }
                        eq-pick(x, y, w, h, r) => { root.eq-pick(x, y, w, h, r) }
                        eq-drag(i, x, y, w, h) => { root.eq-drag(i, x, y, w, h); }
                        eq-widen(i, n) => { root.eq-widen(i, n); }
                    }
                    if root.view == "apps": AppsView {
                        lanes: root.lanes;
                        playing: root.apps-playing;
                        empty: root.apps-empty;
                        move-app(exe, ch) => { root.move-app(exe, ch); }
                    }
                    if root.view == "mic": MicView {
                        mic: root.mic-data;
                        chain: root.chain;
                        selected <=> root.mic-step;
                        eq: root.mic-eq;
                        eq-selected <=> root.mic-eq-selected;
                        set(k, v) => { root.mic-set(k, v); }
                        toggle(k, v) => { root.mic-toggle(k, v); }
                        mute => { root.mic-mute(); }
                        listen => { root.mic-listen(); }
                        test(a) => { root.mic-test(a); }
                        open-devices => { root.open-devices(); }
                        eq-preset(p) => { root.mic-eq-preset(p); }
                        eq-pick(x, y, w, h, r) => { root.mic-eq-pick(x, y, w, h, r) }
                        eq-drag(i, x, y, w, h) => { root.mic-eq-drag(i, x, y, w, h); }
                        eq-widen(i, n) => { root.mic-eq-widen(i, n); }
                    }
                    if root.view == "settings": HorizontalLayout {
                        alignment: center;
                        // A centred column, at most 1120px wide.
                        SettingsView {
                            width: min(1120px, parent.width);
                            tab <=> root.settings-tab;
                            devices-warn: root.health.failing > 0;
                            playback-rows: root.playback-rows;
                            cable-rows: root.cable-rows;
                            master-per-output: root.master-per-output;
                            health: root.health;
                            health-expanded <=> root.health-expanded;
                            delay: root.delay;
                            launch-at-login: root.launch-at-login;
                            windows-defaults: root.windows-defaults;
                            shortcut-groups: root.shortcut-groups;
                            shortcut-rows: root.shortcut-rows;
                            shortcut-group: root.shortcut-group;
                            shortcut-group-title: root.shortcut-group-title;
                            volume-step: root.volume-step;
                            any-shortcuts: root.any-shortcuts;
                            updates: root.updates;
                            tab-changed(t) => { root.settings-tab-changed(t); }
                            pick-device(k, id) => { root.pick-device(k, id); }
                            preference(n, v) => { root.preference(n, v); }
                            retry => { root.retry(); }
                            measure => { root.measure(); }
                            launch(v) => { root.launch(v); }
                            defaults(v) => { root.defaults(v); }
                            open-log => { root.open-log(); }
                            shortcut-group-changed(g) => { root.shortcut-group-changed(g); }
                            record(a) => { root.record(a); }
                            clear-shortcut(a) => { root.clear-shortcut(a); }
                            use-here(a) => { root.use-here(a); }
                            volume-step-changed(v) => { root.volume-step-changed(v); }
                            reset-shortcuts => { root.reset-shortcuts(); }
                            check-updates => { root.check-updates(); }
                            install-update => { root.install-update(); }
                            more-changelog => { root.more-changelog(); }
                        }
                    }
                }
            }
        }
    }

    if root.toast != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 20px;
        width: min(t.preferred-width + 28px, parent.width - 40px);
        height: t.preferred-height + 16px;
        border-radius: 8px;
        background: root.toast-error ? Theme.hot : Theme.text;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: #00000040;
        t := Text {
            text: root.toast;
            color: root.toast-error ? #ffffff : Theme.window;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }
        accessible-role: text;
        accessible-label: root.toast;
    }
    if root.confirm-text != "": Rectangle {
        background: #00000073;
        TouchArea { clicked => { root.confirm-dismissed(); } }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(360px, parent.width - 32px);
            height: dialog.preferred-height;
            background: Theme.panel;
            border-width: Px.hair();
            border-color: Theme.line-strong;
            border-radius: 8px;
            TouchArea { }
            dialog := VerticalLayout {
                padding: 16px;
                spacing: 14px;
                Text { text: root.confirm-text; color: Theme.text; font-size: 13px; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    height: 30px;
                    TextButton { text: "Cancel"; clicked => { root.confirm-dismissed(); } }
                    Rectangle {
                        width: c-text.preferred-width + 24px;
                        border-radius: 6px;
                        background: Theme.hot;
                        c-text := Text { text: root.confirm-action; color: Theme.window; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.confirm-accepted(); }
                        }
                        accessible-role: button;
                        accessible-label: root.confirm-action;
                        accessible-action-default => { root.confirm-accepted(); }
                    }
                }
            }
        }
    }
}
